            "label": "2026-04-13_14-56-15",
            "content": "package main\n\nimport (\n\t\"fmt\"\n\t\"math/rand\"\n)\n\nfunc randInt(min, max int) int {\n\treturn min + rand.Intn(max-min+1)\n}\n\nfunc drawTree(pen *Pen, comprimento float64) {\n\tif comprimento < 2 {\n\t\treturn\n\t}\n\n\tdegree := 35.0\n\n\tpen.Walk(comprimento)\n\tpen.Right(degree)\n\n\tdrawTree(pen, comprimento*0.66)\n\n\tpen.Left(2 * degree)\n\tdrawTree(pen, comprimento*0.66)\n\n\tpen.Right(degree)\n\tpen.Walk(-comprimento)\n}\n\nfunc main() {\n\tpen := NewPen(1000, 1000)\n\tpen.SetRGB(70, 70, 10)\n\tpen.SetPosition(500, 1000)\n\tpen.SetHeading(90)\n\tpen.Walk(150)\n\n\tdrawTree(pen, 200)\n\tpen.SetRGB(255, 0, 0)\n\n\tpen.SavePNG(\"tree.png\")\n\tfmt.Println(\"PNG file created successfully.\")\n}\n",
